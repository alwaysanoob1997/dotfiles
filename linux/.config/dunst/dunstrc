[global]
    width = 360
    height = (0, 120)
    origin = top-right
    offset = (20, 20)

    font = JetBrainsMono Nerd Font 12
    corner_radius = 14

    frame_width = 1
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    gap_size = 8

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    icon_position = left
    max_icon_size = 48

    sticky_history = yes
    history_length = 20

    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = context

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0

    ignore_newline = false
    idle_threshold = 120
    transparency = 5

    background = "#0e151388"
    foreground = "#dde4e1"
    frame_color = "#3f4946"


[urgency_low]
    timeout = 4

    background = "#1a211f88"
    foreground = "#bec9c5"
    frame_color = "#3f4946"


[urgency_normal]
    timeout = 6

    background = "#0e151388"
    foreground = "#dde4e1"
    frame_color = "#3f4946"


[urgency_critical]
    timeout = 0

    background = "#93000a88"
    foreground = "#ffdad6"
    frame_color = "#ffb4ab"
