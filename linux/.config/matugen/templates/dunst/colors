[global]
    width = 360
    height = (0, 120)
    origin = top-right
    offset = (20, 20)

    font = JetBrainsMono Nerd Font 10
    corner_radius = 14

    frame_width = 1
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    gap_size = 8

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    icon_position = left
    max_icon_size = 48

    sticky_history = yes
    history_length = 20

    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = context

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0

    ignore_newline = false
    idle_threshold = 120
    transparency = 5

    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.outline.default.hex}}"


[urgency_low]
    timeout = 4

    background = "{{colors.surface_container.default.hex}}"
    foreground = "{{colors.on_surface_variant.default.hex}}"
    frame_color = "{{colors.outline.default.hex}}"


[urgency_normal]
    timeout = 6

    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.outline.default.hex}}"


[urgency_critical]
    timeout = 0

    background = "{{colors.error_container.default.hex}}"
    foreground = "{{colors.on_error_container.default.hex}}"
    frame_color = "{{colors.error.default.hex}}"
