"""
Insert login information using Bitwarden CLI and a dmenu-compatible application
(e.g. dmenu, rofi -dmenu, ...).
"""

USAGE = """The domain of the site has to be in the name of the Bitwarden entry, for example: "github.com/cryzed" or
"websites/github.com".  The login information is inserted by emulating key events using qutebrowser's fake-key command in this manner:
[USERNAME]<Tab>[PASSWORD], which is compatible with almost all login forms.

If enabled, with the `--totp` flag, it will also move the TOTP code to the
clipboard, much like the Firefox add-on.

You must log into Bitwarden CLI using `bw login` prior to use of this script.
The session key will be stored using keyctl for the number of seconds passed to
the --auto-lock option.

To use in qutebrowser, run: `spawn --userscript qute-bitwarden`
"""

EPILOG = """Dependencies: tldextract (Python 3 module), pyperclip (optional
Python module, used for TOTP codes), Bitwarden CLI (1.7.4 is known to work
but older versions may well also work)

WARNING: The login details are viewable as plaintext in qutebrowser's debug log
(qute://log) and might be shared if you decide to submit a crash report!"""

import argparse
import enum
import functools
import json
import os
import shlex
import subprocess
import sys

import tldextract

argument_parser = argparse.ArgumentParser(
    description=__doc__,
    usage=USAGE,
    epilog=EPILOG,
)
argument_parser.add_argument("url", nargs="?", default=os.getenv("QUTE_URL"))
argument_parser.add_argument(
    "--dmenu-invocation",
    "-d",
    default="rofi -dmenu -i -matching fuzzy -p Bitwarden",
    help="Invocation used to execute a dmenu-provider",
)
argument_parser.add_argument(
    "--password-prompt-invocation",
    "-p",
    default='rofi -dmenu -p "Master Password" -password -lines 0',
    help="Invocation used to prompt the user for their Bitwarden password",
)
argument_parser.add_argument(
    "--no-insert-mode",
    "-n",
    dest="insert_mode",
    action="store_false",
    help="Don't automatically enter insert mode",
)
argument_parser.add_argument(
    "--totp", "-t", action="store_true", help="Copy TOTP key to clipboard"
)
argument_parser.add_argument(
    "--io-encoding",
    "-i",
    default="UTF-8",
    help="Encoding used to communicate with subprocesses",
)
argument_parser.add_argument(
    "--merge-candidates",
    "-m",
    action="store_true",
    help="Merge pass candidates for fully-qualified and registered domain name",
)
argument_parser.add_argument(
    "--auto-lock",
    type=int,
    default=900,
    help="Automatically lock the vault after this many seconds",
)
group = argument_parser.add_mutually_exclusive_group()


group.add_argument(
    "--username-only", "-e", action="store_true", help="Only insert username"
)
group.add_argument(
    "--password-only", "-w", action="store_true", help="Only insert password"
)
group.add_argument(
    "--totp-only", "-T", action="store_true", help="Only insert totp code"
)

stderr = functools.partial(print, file=sys.stderr)


class ExitCodes(enum.IntEnum):
    SUCCESS = 0
    FAILURE = 1
    # 1 is automatically used if Python throws an exception
    NO_PASS_CANDIDATES = 2
    COULD_NOT_MATCH_USERNAME = 3
    COULD_NOT_MATCH_PASSWORD = 4


def qute_command(command):
    with open(os.environ["QUTE_FIFO"], "w") as fifo:
        fifo.write(command + "\n")
        fifo.flush()


def clean_stdout(arguments: list, query: str | None, encoding):

    process = subprocess.run(
        arguments, capture_output=True, text=True, encoding=encoding
    )

    if process.returncode != 0:
        if process.stderr.strip():
            stderr(f"rbw returned for {query} - {process.stderr.strip()}")
        return ""

    output = process.stdout.strip()
    return output


def rbw_search(query, encoding) -> list:
    """Get Bitwarden entries matching a URL"""
    if query:
        arguments = ["rbw", "search", "--fields", "id", query]
    else:
        arguments = ["rbw", "list", "--fields", "id"]
    output = clean_stdout(arguments, query, encoding=encoding)
    entries = output.split("\n")
    return [line.strip() for line in entries if line.strip()]


def rbw_get(query, encoding):
    """
    Get Bitwarden entries matching a name or URL.
    """

    arguments = ["rbw", "get", "--full", "--raw", query]

    output = clean_stdout(arguments, query, encoding)

    if not output:
        return []

    try:
        result = json.loads(output)
    except json.JSONDecodeError:
        stderr("Could not parse rbw output for {!r}".format(query))
        return []

    if isinstance(result, list):
        return result

    return [result]


def get_totp_code(selection, encoding):
    """
    Retrieve the current TOTP code using rbw.
    """
    selection_id = selection.get("id")

    if not selection_id:
        return ""

    process = subprocess.run(
        [
            "rbw",
            "get",
            "--field=totp",
            selection_id,
        ],
        capture_output=True,
        text=True,
        encoding=encoding,
    )

    if process.returncode != 0:
        if process.stderr.strip():
            stderr(
                "rbw TOTP lookup failed for {:s} - {:s}".format(
                    selection.get("name") or "<no name>",
                    process.stderr.strip(),
                )
            )
        return ""

    return process.stdout.strip()


def dmenu(items, invocation, encoding):
    command = shlex.split(invocation)
    process = subprocess.run(
        command, input="\n".join(items).encode(encoding), stdout=subprocess.PIPE
    )
    return process.stdout.decode(encoding).strip()


def fake_key_raw(text):
    if not text:
        return

    commands = []

    for character in text:
        # Escape all characters by default, space requires special handling
        sequence = '" "' if character == " " else r"\{}".format(character)
        commands.append("fake-key {}".format(sequence))

    with open(os.environ["QUTE_FIFO"], "w") as fifo:
        fifo.write("\n".join(commands) + "\n")
        fifo.flush()


def login_entries(entries):
    """
    Keep only Bitwarden Login items.

    The full vault can contain cards, identities, secure notes, etc.
    """
    return [entry for entry in entries if entry.get("login") is not None]
    # return [entry for entry in entries if entry.get("login") is not None]


def display_name(entry):
    name = entry.get("name") or "<no name>"
    login = entry.get("data") or {}
    username = login.get("username") or "<no username>"

    return "{:s} | {:s}".format(name, username)


def select_candidate(candidates: list[dict], arguments) -> dict:
    """
    Select an entry from candidates.

    If there is only one candidate, select it automatically.
    Otherwise use Rofi.
    """
    if not candidates:
        return {}

    if len(candidates) == 1:
        return candidates[0]

    choices = [display_name(candidate) for candidate in candidates]
    choice = dmenu(
        choices,
        arguments.dmenu_invocation,
        arguments.io_encoding,
    )

    if not choice:
        return {}

    try:
        index = choices.index(choice)
    except ValueError:
        return {}

    return candidates[index]


def main(arguments):
    if not arguments.url:
        argument_parser.print_help()
        return ExitCodes.FAILURE

    extract_result = tldextract.extract(arguments.url)

    # Try progressively broader URL targets, preserving the behavior
    # of the original qute-bitwarden script.
    targets = list(
        filter(
            None,
            [
                extract_result.fqdn,
                (
                    extract_result.top_domain_under_public_suffix
                    if hasattr(
                        extract_result,
                        "top_domain_under_public_suffix",
                    )
                    else extract_result.registered_domain
                ),
                extract_result.subdomain + "." + extract_result.domain,
                extract_result.domain,
                extract_result.ipv4,
            ],
        )
    )

    candidates = []

    for target in targets:
        target_candidates = rbw_search(
            target,
            arguments.io_encoding,
        )

        if not target_candidates:
            continue

        candidates.extend(target_candidates)

        if not arguments.merge_candidates:
            break

    # No URL match:
    # retrieve the entire vault and let Rofi handle the search.
    if not candidates:
        candidates = rbw_search(query="", encoding=arguments.io_encoding)

    entries = []
    for entry in candidates:
        entries.extend(rbw_get(entry, encoding=arguments.io_encoding))

    selection = select_candidate(
        entries,
        arguments,
    )

    # Nothing selected.
    if not selection:
        return ExitCodes.SUCCESS

    login = selection.get("data") or {}

    username = login.get("username") or ""
    password = login.get("password") or ""

    if arguments.username_only:
        fake_key_raw(username)

    elif arguments.password_only:
        fake_key_raw(password)

    elif arguments.totp_only:
        totp = get_totp_code(
            selection,
            arguments.io_encoding,
        )

        if totp:
            fake_key_raw(totp)

    else:
        fake_key_raw(username)
        qute_command("fake-key <Tab>")
        fake_key_raw(password)

    if arguments.insert_mode:
        qute_command("mode-enter insert")

    # Copy TOTP to clipboard if requested.
    if not arguments.totp_only and arguments.totp:
        totp = get_totp_code(
            selection,
            arguments.io_encoding,
        )

        if totp:
            import pyperclip

            pyperclip.copy(totp)

    return ExitCodes.SUCCESS


if __name__ == "__main__":
    arguments = argument_parser.parse_args()
    sys.exit(main(arguments))
